<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PunchIO.Configuration</RootNamespace>
    <AssemblyName>PunchIO.Configuration</AssemblyName>
    <!-- Source-generated binding, not reflection: the native EXFH host publishes
         with NativeAOT and reflection-based binding would not survive it. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>PunchIO.Configuration</PackageId>
    <Description>Named per-file profiles for PunchIO.Core, bound from Microsoft.Extensions.Configuration with source-generated, NativeAOT-safe binding. Presets seed a layout and explicit keys override it; every profile is validated at startup.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PunchIO.Core\PunchIO.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
